# -----------------------------------------------------------------------------
# KU-Paper Environment Variables Template
# Copy this file to '.env' and populate with your own live Supabase credentials
# -----------------------------------------------------------------------------

# Supabase Project URL (obtained from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (obtained from Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (obtained from Project Settings -> API)
# WARNING: Keep this secure! Do NOT commit this key to Git.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

